<span id="cb1-31"><a href="#cb1-31" aria-hidden="true" tabindex="-1"></a>      <span class="at">UseAmortized =</span> <span class="cn">TRUE</span><span class="sc">|</span><span class="cn">FALSE</span></span>
<span id="cb1-32"><a href="#cb1-32" aria-hidden="true" tabindex="-1"></a>    ),</span>
<span id="cb1-33"><a href="#cb1-33" aria-hidden="true" tabindex="-1"></a>    <span class="at">TimeUnit =</span> <span class="st">"DAILY"</span><span class="sc">|</span><span class="st">"MONTHLY"</span><span class="sc">|</span><span class="st">"QUARTERLY"</span><span class="sc">|</span><span class="st">"ANNUALLY"</span>,</span>
<span id="cb1-34"><a href="#cb1-34" aria-hidden="true" tabindex="-1"></a>    <span class="at">TimePeriod =</span> <span class="fu">list</span>(</span>
