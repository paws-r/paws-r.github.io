    <div id="ref-examples">
    <h2>Examples</h2>
    <div class="sourceCode"><pre class="sourceCode r"><code><span><span class="kw">if</span> <span class="op">(</span><span class="cn">FALSE</span><span class="op">)</span> <span class="op">{</span></span>
<span><span class="co"># This example deletes the my-http-service service. The service must have</span></span>
<span><span class="co"># a desired count and running count of 0 before you can delete it.</span></span>
<span><span class="va">svc</span><span class="op">$</span><span class="fu">delete_service</span><span class="op">(</span></span>
<span>  service <span class="op">=</span> <span class="st">"my-http-service"</span></span>
<span><span class="op">)</span></span>
<span><span class="op">}</span></span>
<span></span></code></pre></div>
