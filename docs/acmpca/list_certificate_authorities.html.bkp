<span id="cb1-22"><a href="#cb1-22" aria-hidden="true" tabindex="-1"></a>      <span class="at">CertificateAuthorityConfiguration =</span> <span class="fu">list</span>(</span>
<span id="cb1-23"><a href="#cb1-23" aria-hidden="true" tabindex="-1"></a>        <span class="at">KeyAlgorithm =</span> <span class="st">"RSA_2048"</span><span class="sc">|</span><span class="st">"RSA_4096"</span><span class="sc">|</span><span class="st">"EC_prime256v1"</span><span class="sc">|</span><span class="st">"EC_secp384r1"</span>,</span>
