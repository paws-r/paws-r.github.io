ax/libs/headroom/0.11.0/jQuery.headroom.min.js" integrity="sha256-ZX/yNShbjqsohH1k95liqY9Gd8uOiE1S4vZc+9KQ1K4=" crossorigin="anonymous"></script><!-- pkgdown --><link href="../pkgdown.css" rel="stylesheet"><script href="../pkgdown.js"></script><meta property="og:title" content="Adds, edits, or deletes tags for a health check or a hosted zone — route53_change_tags_for_resource"><meta property="og:description" content="Adds, edits, or deletes tags for a health check or a hosted zone.
