    <div id="ref-examples">
    <h2>Examples</h2>
    <div class="sourceCode"><pre class="sourceCode r"><code><span><span class="kw">if</span> <span class="op">(</span><span class="cn">FALSE</span><span class="op">)</span> <span class="op">{</span></span>
<span><span class="co"># The following operation creates a configuration template named my-app-v1</span></span>
<span><span class="co"># from the settings applied to an environment with the id e-rpqsewtp2j:</span></span>
<span><span class="va">svc</span><span class="op">$</span><span class="fu">create_configuration_template</span><span class="op">(</span></span>
<span>  ApplicationName <span class="op">=</span> <span class="st">"my-app"</span>,</span>
<span>  EnvironmentId <span class="op">=</span> <span class="st">"e-rpqsewtp2j"</span>,</span>
<span>  TemplateName <span class="op">=</span> <span class="st">"my-app-v1"</span></span>
<span><span class="op">)</span></span>
<span><span class="op">}</span></span>
<span></span></code></pre></div>
