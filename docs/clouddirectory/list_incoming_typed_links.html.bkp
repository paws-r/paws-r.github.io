<span id="cb1-20"><a href="#cb1-20" aria-hidden="true" tabindex="-1"></a>        <span class="at">EndMode =</span> <span class="st">"FIRST"</span><span class="sc">|</span><span class="st">"LAST"</span><span class="sc">|</span><span class="st">"LAST_BEFORE_MISSING_VALUES"</span><span class="sc">|</span><span class="st">"INCLUSIVE"</span><span class="sc">|</span><span class="st">"EXCLUSIVE"</span>,</span>
<span id="cb1-21"><a href="#cb1-21" aria-hidden="true" tabindex="-1"></a>        <span class="at">EndValue =</span> <span class="fu">list</span>(</span>
<span id="cb1-22"><a href="#cb1-22" aria-hidden="true" tabindex="-1"></a>          <span class="at">StringValue =</span> <span class="st">"string"</span>,</span>
<span id="cb1-23"><a href="#cb1-23" aria-hidden="true" tabindex="-1"></a>          <span class="at">BinaryValue =</span> raw,</span>
<span id="cb1-24"><a href="#cb1-24" aria-hidden="true" tabindex="-1"></a>          <span class="at">BooleanValue =</span> <span class="cn">TRUE</span><span class="sc">|</span><span class="cn">FALSE</span>,</span>
<span id="cb1-25"><a href="#cb1-25" aria-hidden="true" tabindex="-1"></a>          <span class="at">NumberValue =</span> <span class="st">"string"</span>,</span>
