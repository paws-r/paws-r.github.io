<span id="cb1-42"><a href="#cb1-42" aria-hidden="true" tabindex="-1"></a>        <span class="at">ReservedNodeOfferingType =</span> <span class="st">"Regular"</span><span class="sc">|</span><span class="st">"Upgradable"</span></span>
<span id="cb1-43"><a href="#cb1-43" aria-hidden="true" tabindex="-1"></a>      )</span>
