<span>    <span class="st">"us-west-2a"</span></span>
<span>  <span class="op">)</span>,</span>
<span>  Listeners <span class="op">=</span> <span class="fu"><a href="https://rdrr.io/r/base/list.html" class="external-link">list</a></span><span class="op">(</span></span>
<span>    <span class="fu"><a href="https://rdrr.io/r/base/list.html" class="external-link">list</a></span><span class="op">(</span></span>
