<span>    <span class="op">)</span></span>
<span>  <span class="op">)</span>,</span>
<span>  LoadBalancerName <span class="op">=</span> <span class="st">"my-load-balancer"</span>,</span>
<span>  SecurityGroups <span class="op">=</span> <span class="fu"><a href="https://rdrr.io/r/base/list.html" class="external-link">list</a></span><span class="op">(</span></span>
<span>    <span class="st">"sg-a61988c3"</span></span>
<span>  <span class="op">)</span>,</span>
<span>  Subnets <span class="op">=</span> <span class="fu"><a href="https://rdrr.io/r/base/list.html" class="external-link">list</a></span><span class="op">(</span></span>
